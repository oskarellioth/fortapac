---
import SiteNav from "../components/SiteNav.tsx";
import Footer from "../components/Footer.astro";
import {
  content, products, industries, pick, ROUTES, anchors,
  routeKeyForPath, productHrefs, type Locale,
} from "../lib/content";
import { isIndexableHost } from "../lib/site";
import "../styles/site.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;

const path = Astro.url.pathname;
const other: Locale = locale === "sv" ? "en" : "sv";
const routeKey = routeKeyForPath(path) ?? "home";

const svHref = ROUTES[routeKey].sv;
const enHref = ROUTES[routeKey].en;
const canonical = new URL(locale === "sv" ? svHref : enHref, Astro.site).toString();

const navCopy = content.navigation;

const indexable = isIndexableHost(Astro.url.hostname);

// Social preview. Falls back to the hero photo until a purpose-made 1200x630
// share image exists, which is better than the blank grey box a missing
// og:image produces in LinkedIn, Slack and email.
const shareImage = new URL(
  content.site.shareImage
    ? `/share/${content.site.shareImage}`
    : content.home.heroImage || "/hero/home.jpg",
  Astro.site,
).toString();

const labels = {
  productPhoto: pick(
    { sv: "Produktbild kommer snart", en: "Product photo coming soon" },
    locale,
  ),
  featured: pick({ sv: "Produkt i fokus", en: "Featured product" }, locale),
  featuredLink: pick({ sv: "Visa produktdetaljer", en: "View product details" }, locale),
  menu: pick({ sv: "Öppna meny", en: "Open menu" }, locale),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sv" href={new URL(svHref, Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(svHref, Astro.site).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === "sv" ? "sv_SE" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "sv" ? "en_US" : "sv_SE"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Fortapac" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Fonts are self-hosted rather than pulled from Google. The external
      stylesheet was a render-blocking request to a third party before any text
      could paint, and it needed two preconnects just to soften that. Latin and
      latin-ext subsets only, which is all Swedish and English need, at 167KB
      for every weight in use.

      Preloading the two faces that appear above the fold, the Archivo used by
      the hero headline and the body text, so they are fetched alongside the CSS
      rather than after it.
    */}
    <link
      rel="preload"
      href="/fonts/Archivo-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/IBMPlexSans-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        // Fortapac is the brand everywhere a customer looks. The registered
        // entity appears only in the legal pages' fine print, so legalName is
        // the correct field for it rather than name.
        name: "Fortapac",
        ...(content.site.legalEntityName && { legalName: content.site.legalEntityName }),
        url: Astro.site?.toString(),
        logo: new URL("/favicon.svg", Astro.site).toString(),
        image: shareImage,
        email: content.site.email,
        description: description,
        // The brief is explicit that Fortapac must not be described as the
        // manufacturer in structured data, so no manufacturer field here.
        ...(content.site.vatNumber && { vatID: content.site.vatNumber }),
        ...(content.site.orgNumber && { taxID: content.site.orgNumber }),
        ...(content.site.phone && { telephone: content.site.phone }),
        ...(content.site.linkedin && { sameAs: [content.site.linkedin] }),
        address: {
          "@type": "PostalAddress",
          addressLocality: "Göteborg",
          addressCountry: "SE",
        },
        areaServed: { "@type": "Country", name: "Sweden" },
      })}
    />
  </head>

  <body>
    <div class="fortapac">
      <SiteNav
        client:load
        locale={locale}
        copy={navCopy}
        products={products}
        industries={industries}
        homePath={ROUTES.home[locale]}
        aboutPath={ROUTES.about[locale]}
        otherLocaleHref={ROUTES[routeKey][other]}
        anchors={anchors(locale)}
        productHrefs={productHrefs(locale)}
        productPhotoLabel={labels.productPhoto}
        featuredLabel={labels.featured}
        featuredLinkLabel={labels.featuredLink}
        menuLabel={labels.menu}
      />
      <slot />
      <Footer locale={locale} />
    </div>
  </body>
</html>
