---
import { content, products, industries, pick, type Locale } from "../lib/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const h = content.home;

const specs = [
  { value: h.specSwlValue, label: h.specSwlLabel },
  { value: h.specSafetyValue, label: h.specSafetyLabel },
  { value: h.specUvValue, label: h.specUvLabel },
  { value: h.specRecycleValue, label: h.specRecycleLabel },
];

const sustainIcons = [
  "M25 14l7-7 7 7 M32 7v17 M47 37l3 10-10 3 M50 47 36 39 M17 50 7 47l3-10 M7 47l14-8",
  "M52 12C27 12 14 25 13 52c26-2 39-15 39-40Z M14 51c9-15 20-24 37-37",
  "M10 32h44M32 10c8 8 8 36 0 44M32 10c-8 8-8 36 0 44",
];
---

<main>
  <section class="hero">
    <picture class="hero-image">
      {h.heroImageMobile && <source media="(max-width: 980px)" srcset={h.heroImageMobile} />}
      {h.heroImage && <img src={h.heroImage} alt="" />}
    </picture>
    <div class="hero-wrap hero-shell">
      <div class="hero-content">
        <h1>
          {pick(h.heroTitleLine1, locale)}<br />{pick(h.heroTitleLine2, locale)}<span style="color:var(--orange)">.</span>
        </h1>
        <p>{pick(h.heroBody, locale)}</p>
        <div class="hero-actions">
          <a class="button primary" href="#products">
            {pick(h.heroButtonPrimary, locale)} <span class="arrow">→</span>
          </a>
          <a class="button dark" href="#contact">
            {pick(h.heroButtonSecondary, locale)} <span class="arrow">→</span>
          </a>
        </div>
        <div class="made-in mono"><span class="flag"></span> {pick(h.heroBadge, locale)}</div>
      </div>
    </div>
  </section>

  <section id="products">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow mono">{pick(h.productsEyebrow, locale)}</div>
          <h2>{pick(h.productsHeading, locale)}</h2>
        </div>
        <a class="view-link mono" href="#">
          {pick(h.productsLink, locale)} <span class="arrow">→</span>
        </a>
      </div>
      <div class="products-grid">
        {products.slice(0, 4).map((p) => (
          <article class="product-card">
            <div>
              {p.icon && <img class="product-image" src={p.icon} alt="" loading="lazy" />}
              <h3>{pick(p.name, locale)}</h3>
              <p>{pick(p.cardBlurb, locale)}</p>
            </div>
            <div class="mono">{pick(p.cardMeta, locale)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="spec-row">
    <div class="wrap spec-grid">
      <div>
        <div class="eyebrow mono">{pick(h.specEyebrow, locale)}</div>
        <h2 style="font-size:clamp(2rem,3vw,3rem)">{pick(h.specHeading, locale)}</h2>
      </div>
      {specs.map((s) => (
        <div class="spec-card">
          <div class="spec-value">{s.value}</div>
          <div class="mono">{pick(s.label, locale)}</div>
        </div>
      ))}
    </div>
  </div>

  <section id="industries" class="industries">
    <div class="wrap industry-layout">
      <div>
        <div class="eyebrow mono">{pick(h.industriesEyebrow, locale)}</div>
        <h2 style="font-size:2.35rem">{pick(h.industriesHeading, locale)}</h2>
        <a class="view-link mono" style="margin-top:2rem" href="#">
          {pick(h.industriesLink, locale)} <span class="arrow">→</span>
        </a>
      </div>
      <div class="industry-grid">
        {industries.slice(0, 5).map((i) => (
          <article class="industry-card">
            <div class="placeholder-image">{pick(i.name, locale)}</div>
            <h3>{pick(i.name, locale)}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="materials" class="material">
    <div class="material-grid">
      <div class="placeholder-fill">
        <div class="tag">{locale === "sv" ? "Vävmakro" : "Weave macro"}</div>
      </div>
      <div class="material-copy">
        <div>
          <div class="eyebrow mono">{pick(h.materialsEyebrow, locale)}</div>
          <h2>{pick(h.materialsHeading, locale)}</h2>
          <p style="margin:1.25rem 0 1.75rem;max-width:560px">{pick(h.materialsBody, locale)}</p>
          <a class="button light" href="#">
            {pick(h.materialsLink, locale)} <span class="arrow">→</span>
          </a>
        </div>
        <div class="weave-diagram">
          <svg viewBox="0 0 240 240" aria-hidden="true">
            <g fill="none" stroke="#102A43" stroke-width="5">
              <path d="M45 25v170M75 25v170M105 25v170M135 25v170M165 25v170M195 25v170" />
              <path d="M25 45h170M25 75h170M25 105h170M25 135h170M25 165h170M25 195h170" />
            </g>
            <path d="M150 60h55" stroke="#DE5B26" stroke-width="4" />
            <path d="M150 160h55" stroke="#5E7790" stroke-width="4" />
            <text x="154" y="53" font-family="IBM Plex Mono, monospace" font-size="10" fill="#102A43">
              {locale === "sv" ? "VARP" : "WARP"}
            </text>
            <text x="154" y="153" font-family="IBM Plex Mono, monospace" font-size="10" fill="#102A43">
              {locale === "sv" ? "INSLAG" : "WEFT"}
            </text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section id="sustainability" class="sustainability">
    <div class="sustainability-grid">
      <div>
        <div class="eyebrow mono">{pick(h.sustainabilityEyebrow, locale)}</div>
        <h2 style="font-size:2.5rem">{pick(h.sustainabilityHeading, locale)}</h2>
      </div>
      {h.sustainabilityCards.map((c, i) => (
        <div>
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              {i === 2 ? <circle cx="32" cy="32" r="22" /> : null}
              <path d={sustainIcons[i] ?? sustainIcons[0]} />
            </g>
          </svg>
          <h3>{pick(c.title, locale)}</h3>
          <p>{pick(c.body, locale)}</p>
        </div>
      ))}
      <div>
        <div class="placeholder-fill">
          <div class="tag">{locale === "sv" ? "Insydd etikett" : "Sewn-in label"}</div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="cta">
    <div class="wrap cta-inner">
      <div class="woven-lines"></div>
      <div>
        <h2 style="font-size:2rem">{pick(h.ctaHeading, locale)}</h2>
        <p style="color:rgba(255,255,255,.8);max-width:620px">{pick(h.ctaBody, locale)}</p>
      </div>
      <a class="button primary" href={`mailto:${content.site.email}`}>
        {pick(h.heroButtonSecondary, locale)} <span class="arrow">→</span>
      </a>
    </div>
  </section>
</main>
